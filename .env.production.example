# ==================================================
# Project Monitor - Production Environment (Oracle Cloud)
# ==================================================
# Copy to .env.production and fill in values
# ==================================================

# ==================================================
# PostgreSQL (CHANGE THESE!)
# ==================================================
POSTGRES_DB=project_monitor
POSTGRES_USER=monitor_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ==================================================
# Security (CHANGE THESE!)
# ==================================================
JWT_SECRET=GENERATE_WITH_python3_-c_"import_secrets;_print(secrets.token_hex(32))"
API_SECRET_KEY=GENERATE_WITH_python3_-c_"import_secrets;_print(secrets.token_hex(16))"

# ==================================================
# Domain (for SSL and n8n)
# ==================================================
DOMAIN_NAME=your-domain.com

# ==================================================
# DeepSeek AI (optional)
# ==================================================
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==================================================
# Telegram Notifications (optional)
# ==================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# ==================================================
# Email (optional)
# ==================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_ENABLED=true

# ==================================================
# Slack (optional)
# ==================================================
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_ENABLED=true

# ==================================================
# Data Retention
# ==================================================
DATA_RETENTION_DAYS=90
ARCHIVE_ENABLED=true

# ==================================================
# SSH
# ==================================================
SSH_TIMEOUT=30
SSH_RETRY_ATTEMPTS=3
