# ==================================================
# Project Monitor - Environment Configuration
# ==================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# ==================================================

# ==================================================
# PostgreSQL
# ==================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=project_monitor
POSTGRES_USER=monitor_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ==================================================
# Redis
# ==================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ==================================================
# n8n (Existing instance on port 5678)
# ==================================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_API_KEY=YOUR_N8N_API_KEY_HERE

# ==================================================
# Monitoring Agent Service
# ==================================================
MONITORING_AGENT_HOST=0.0.0.0
MONITORING_AGENT_PORT=8000
MONITORING_API_URL=http://monitoring-agent:8000
APP_BASE_URL=http://localhost:5678

# ==================================================
# DeepSeek AI (optional)
# ==================================================
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==================================================
# Telegram Notifications (optional)
# ==================================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
TELEGRAM_ENABLED=true

# ==================================================
# Security
# ==================================================
JWT_SECRET=GENERATE_WITH_python3_-c_"import_secrets;_print(secrets.token_hex(32))"
API_SECRET_KEY=GENERATE_WITH_python3_-c_"import_secrets;_print(secrets.token_hex(16))"

# ==================================================
# SSH Configuration
# ==================================================
SSH_TIMEOUT=30
SSH_RETRY_ATTEMPTS=3

# ==================================================
# Backup & Remediation
# ==================================================
LOCAL_BACKUP_PATH=/app/backups
AUTO_REMEDIATION_ENABLED=true
REQUIRE_HUMAN_APPROVAL_ABOVE=moderate
MAX_REMEDIATION_ATTEMPTS=3
VERIFICATION_DELAY_SECONDS=30
MAX_VERIFICATION_ATTEMPTS=3

# ==================================================
# Email (optional)
# ==================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
EMAIL_ENABLED=true

# ==================================================
# Slack (optional)
# ==================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=
SLACK_ENABLED=true

# ==================================================
# Data Retention
# ==================================================
DATA_RETENTION_DAYS=90
ARCHIVE_ENABLED=true

# ==================================================
# Monitoring Thresholds (defaults, overridable per project)
# ==================================================
DISK_WARNING_THRESHOLD=75
DISK_CRITICAL_THRESHOLD=90
CPU_WARNING_THRESHOLD=80
CPU_CRITICAL_THRESHOLD=95
RAM_WARNING_THRESHOLD=80
RAM_CRITICAL_THRESHOLD=95
SSL_WARNING_DAYS=30
SSL_CRITICAL_DAYS=7
RESPONSE_TIME_WARNING_MS=2000
RESPONSE_TIME_CRITICAL_MS=5000
