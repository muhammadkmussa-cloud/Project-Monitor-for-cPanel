{
  "name": "03 - Health Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://monitoring-agent:8000/api/v1/projects?monitoring_enabled=true",
        "options": {}
      },
      "id": "get-projects",
      "name": "Get Enabled Projects",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-projects",
      "name": "Split Projects",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://monitoring-agent:8000/api/v1/projects/{{ $json.project_id }}/health",
        "options": {}
      },
      "id": "check-health",
      "name": "Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "notEqual",
              "value2": "HEALTHY"
            }
          ]
        }
      },
      "id": "check-status",
      "name": "Is Unhealthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://monitoring-agent:8000/api/v1/incidents",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "project_id",
              "value": "={{ $('Split Projects').item.json.project_id }}"
            },
            {
              "name": "client_id",
              "value": "={{ $('Split Projects').item.json.client_id }}"
            },
            {
              "name": "category",
              "value": "={{ $json.status === 'DOWN' ? 'NETWORK_ERROR' : 'APPLICATION_ERROR' }}"
            },
            {
              "name": "severity",
              "value": "={{ $json.status === 'DOWN' ? 'CRITICAL' : 'HIGH' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "create-incident",
      "name": "Create Incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://monitoring-agent:8000/api/v1/incidents",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "project_id",
              "value": "={{ $('Split Projects').item.json.project_id }}"
            },
            {
              "name": "client_id",
              "value": "={{ $('Split Projects').item.json.client_id }}"
            },
            {
              "name": "category",
              "value": "HEALTH_CHECK_PASSED"
            },
            {
              "name": "severity",
              "value": "LOW"
            }
          ]
        },
        "options": {}
      },
      "id": "record-health",
      "name": "Record Healthy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        420
      ]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Get Enabled Projects",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Enabled Projects": {
      "main": [
        [
          {
            "node": "Split Projects",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Projects": {
      "main": [
        [
          {
            "node": "Health Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health Check": {
      "main": [
        [
          {
            "node": "Is Unhealthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Unhealthy?": {
      "main": [
        [
          {
            "node": "Create Incident",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record Healthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "health-monitor"
    }
  ]
}
