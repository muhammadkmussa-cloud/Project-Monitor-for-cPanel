{
  "name": "06 - AI Diagnostic Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://monitoring-agent:8000/api/v1/incidents?status=OPEN",
        "options": {}
      },
      "id": "get-open-incidents",
      "name": "Get Open Incidents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-incidents",
      "name": "Split Incidents",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://monitoring-agent:8000/api/v1/diagnose",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "incident_id",
              "value": "={{ $json.incident_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "trigger-diagnosis",
      "name": "Trigger AI Diagnosis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.confidence }}",
              "operation": "largerEqual",
              "value2": 0.7
            }
          ]
        }
      },
      "id": "check-confidence",
      "name": "High Confidence?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://monitoring-agent:8000/api/v1/proposals",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "incident_id",
              "value": "={{ $('Split Incidents').item.json.incident_id }}"
            },
            {
              "name": "diagnosis_id",
              "value": "={{ $json.diagnosis_id }}"
            },
            {
              "name": "proposal_summary",
              "value": "={{ $json.proposed_fix }}"
            }
          ]
        },
        "options": {}
      },
      "id": "create-proposal",
      "name": "Create Fix Proposal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=http://monitoring-agent:8000/api/v1/incidents/{{ $('Split Incidents').item.json.incident_id }}/status",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "INVESTIGATING"
            }
          ]
        },
        "options": {}
      },
      "id": "update-incident-status",
      "name": "Update Incident Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        420
      ]
    }
  ],
  "connections": {
    "Every 10 Minutes": {
      "main": [
        [
          {
            "node": "Get Open Incidents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Open Incidents": {
      "main": [
        [
          {
            "node": "Split Incidents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Incidents": {
      "main": [
        [
          {
            "node": "Trigger AI Diagnosis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger AI Diagnosis": {
      "main": [
        [
          {
            "node": "High Confidence?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "High Confidence?": {
      "main": [
        [
          {
            "node": "Create Fix Proposal",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Update Incident Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "ai-diagnostic"
    }
  ]
}
