{
  "name": "Approval Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "approval-request",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-severity",
              "leftValue": "={{ $json.body.severity }}",
              "rightValue": "CRITICAL",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "condition-high",
              "leftValue": "={{ $json.body.severity }}",
              "rightValue": "HIGH",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "check-severity",
      "name": "Check Severity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.body.callback_url }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "incident_id",
              "value": "={{ $json.body.incident_id }}"
            },
            {
              "name": "action",
              "value": "approve"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "send-approval-request",
      "name": "Send Approval Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"approval_sent\", \"incident_id\": $json.body.incident_id } }}"
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.MONITORING_API_URL }}/api/v1/diagnose",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "incident_id",
              "value": "={{ $json.body.incident_id }}"
            },
            {
              "name": "include_logs",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "auto-diagnose",
      "name": "Auto Diagnose",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-safe",
              "leftValue": "={{ $json.body.safety_level }}",
              "rightValue": "safe",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-safety",
      "name": "Check Safety Level",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        400
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.MONITORING_API_URL }}/api/v1/remediation/execute",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "plan_id",
              "value": "={{ $json.body.plan_id }}"
            },
            {
              "name": "incident_id",
              "value": "={{ $json.body.incident_id }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "auto-execute",
      "name": "Auto Execute",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"auto_executed\", \"incident_id\": $json.body.incident_id, \"result\": $json } }}"
      },
      "id": "respond-auto",
      "name": "Respond Auto",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"requires_approval\", \"incident_id\": $json.body.incident_id } }}"
      },
      "id": "respond-approval-needed",
      "name": "Respond Approval Needed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        500
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Check Severity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Severity": {
      "main": [
        [
          {
            "node": "Send Approval Request",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Auto Diagnose",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Approval Request": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auto Diagnose": {
      "main": [
        [
          {
            "node": "Check Safety Level",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Safety Level": {
      "main": [
        [
          {
            "node": "Auto Execute",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Approval Needed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auto Execute": {
      "main": [
        [
          {
            "node": "Respond Auto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "monitoring"
    },
    {
      "name": "approval"
    }
  ]
}
