{
  "id": "1",
  "name": "Unified Monitoring Workflow",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Nairobi"
  },
  "nodes": [
    {
      "id": "monitor-schedule",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "manual-monitor",
      "name": "Manual Scan",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "run-cycle",
      "name": "Check Due Projects",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://monitoring-agent:8000/api/v1/monitoring/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "projectMonitorBackend",
          "name": "Project Monitor Backend"
        }
      }
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [
        [
          {
            "node": "Check Due Projects",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Scan": {
      "main": [
        [
          {
            "node": "Check Due Projects",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
